<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Open Oura</string>
	<key>CFBundleExecutable</key>
	<string>OuraApp</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>Open Oura</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>17.0</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>md.thomas.openoura.sync.refresh</string>
		<string>md.thomas.openoura.sync.processing</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Open Oura connects to your Oura ring over Bluetooth, also in the background, to sync your health data on this device.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Open Oura connects to your Oura ring over Bluetooth, also in the background, to sync your health data on this device.</string>
	<!-- The health hub is reached over Tailscale (WireGuard-encrypted). Plain HTTP is
	     allowed for tailnet names only, so no public certificate is needed. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSHealthShareUsageDescription</key>
	<string>Open Oura can read selected Apple Health data to compare it with your ring metrics on-device.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Open Oura writes your ring measurements (sleep, heart rate, breathing rate, blood oxygen, steps, energy, and workouts) to Apple Health only when you turn on Health export.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
